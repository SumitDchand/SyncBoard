# ==============================================================================
# SyncBoard Platform Configuration Template
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=5001

# Database Configuration (MongoDB Atlas or Local replica set)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/syncboard?retryWrites=true&w=majority

# JSON Web Token Secrets (Generate using: openssl rand -base64 48)
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_at_least_32_chars_long
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_at_least_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS & Domain Configuration
CLIENT_URL=http://localhost:5173
COOKIE_DOMAIN=

# Security & Rate Limiting Controls
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=30

